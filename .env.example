# AI provider: mock, gemini, groq, or ollama
LLM_PROVIDER=mock

# Add your own API key later, if needed
GEMINI_API_KEY=
GROQ_API_KEY=

# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Application configuration
SPRING_PROFILES_ACTIVE=local

# Optional repository inspected by the local MCP server (defaults to this checkout)
SYNCODEX_PROJECT_ROOT=
